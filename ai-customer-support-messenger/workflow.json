    {
      "parameters": {
        "jsCode": "// Pulls the sender and text from a Messenger webhook and flags human-handoff requests.\n// Edit HANDOFF_WORDS to taste (English and Bangla).\nconst HANDOFF_WORDS = ['human', 'agent', 'operator', 'real person', 'call me', 'এজেন্ট', 'মানুষ', 'কারো সাথে কথা', 'কল করুন'];\n\nconst body = $input.first().json.body || $input.first().json;\nconst ev = body?.entry?.[0]?.messaging?.[0];\nif (!ev || !ev.message || ev.message.is_echo || !ev.message.text) return []; // ignore echoes, reads, attachments\n\nconst text = ev.message.text.trim();\nconst lower = text.toLowerCase();\nconst isHandoff = HANDOFF_WORDS.some((w) => lower.includes(w.toLowerCase()));\nreturn [{ json: { senderId: ev.sender.id, text, isHandoff, receivedAt: new Date().toISOString() } }];"
      },
      "id": "571897ea-433b-5d3b-a8be-5a1973be1838",
