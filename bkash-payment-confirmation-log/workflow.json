    {
      "parameters": {
        "jsCode": "// Matches the payment to a pending order.\n// Rule 1: amount must equal the order Total.\n// Rule 2: if several orders have the same amount, the order whose Phone matches the sender number wins.\n// If still ambiguous, nothing is auto-matched (the owner is alerted instead).\nconst pay = $('Parse Payment SMS').first().json;\nconst last11 = (s) => String(s || '').replace(/\\D/g, '').slice(-11);\nconst orders = $input.all().map((i) => i.json).filter((o) => o.OrderID);\nconst sameAmount = orders.filter((o) => Math.abs(parseFloat(o.Total) - pay.amount) < 0.01);\nlet hit = null;\nif (sameAmount.length === 1) hit = sameAmount[0];\nelse if (sameAmount.length > 1) {\n  const byPhone = sameAmount.filter((o) => last11(o.Phone) && last11(o.Phone) === last11(pay.senderNumber));\n  if (byPhone.length === 1) hit = byPhone[0];\n}\nconst toIntl = (p) => { const d = String(p || '').replace(/\\D/g, ''); return /^01\\d{9}$/.test(d) ? '88' + d : d; };\nconst base = { trxId: pay.trxId, amount: pay.amount, provider: pay.provider, senderNumber: pay.senderNumber };\nif (!hit) return [{ json: { ...base, matched: false,\n  note: `Unmatched ${pay.provider} payment Tk ${pay.amount} from ${pay.senderNumber || 'unknown'} (TrxID ${pay.trxId}). Candidates with same amount: ${sameAmount.length}.` } }];\nconst customerWa = toIntl(hit.WhatsApp || hit.Phone);\nreturn [{ json: { ...base, matched: true, orderId: hit.OrderID, customerWa,\n  replyText: `Payment received: Tk ${pay.amount} (TrxID ${pay.trxId}). Your order ${hit.OrderID} is confirmed. Thank you!`,\n  note: `Matched order ${hit.OrderID}` } }];"
      },
