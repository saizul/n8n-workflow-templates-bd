    {
      "parameters": {
        "jsCode": "// Extracts amount, sender number and TrxID from a FORWARDED payment SMS.\n// NOT an official bKash/Nagad integration. It only reads text your phone already received.\n// Message formats change over time: test with your own real messages and adjust the regexes below.\nconst body = $input.first().json.body || $input.first().json;\nconst text = String(body.message ?? body.text ?? body.body ?? body.content ?? '').replace(/\\s+/g, ' ').trim();\nconst from = String(body.from ?? body.sender ?? body.address ?? '').trim();\n\nconst blank = (extra) => [{ json: { parsed: false, ...extra } }];\n\n// Safety: never process anything that looks like a PIN/OTP message, and never keep the raw SMS.\nif (/\\b(pin|otp|verification code|পিন|ওটিপি)\\b/i.test(text)) return blank({ reason: 'sensitive_message_dropped' });\n\nconst hay = from + ' ' + text;\nlet provider = '';\nif (/bkash/i.test(hay) || /TrxID/i.test(text)) provider = 'bKash';\nelse if (/nagad/i.test(hay) || /TxnID/i.test(text)) provider = 'Nagad';\nif (!provider) return blank({ reason: 'not_a_payment_sms' });\n\n// Only incoming money. bKash: \"You have received Tk 500.00 from 01XXXXXXXXX. Fee Tk 0.00. Balance Tk 1,234.00. TrxID ABC123XYZ at 07/11/2026 14:22\"\n// Nagad:  \"Money Received. Amount: Tk 500.00 Sender: 01XXXXXXXXX Ref: N/A TxnID: 7XXXXXXXX Fee: 0.00 Balance: Tk 1,000.00 07/11/2026 14:22\"\nconst incoming = /(you have received|money received|received money|cash in)/i.test(text);\nif (!incoming) return blank({ reason: 'not_incoming', provider });\n\nconst num = (s) => parseFloat(String(s).replace(/,/g, ''));\nlet amountM, senderM, trxM;\nif (provider === 'bKash') {\n  amountM = text.match(/received\\s+Tk\\.?\\s*([\\d,]+(?:\\.\\d+)?)/i);\n  senderM = text.match(/from\\s+(?:\\+?88)?(01\\d{9})/i);\n  trxM = text.match(/TrxID\\s*[:\\-]?\\s*([A-Z0-9]{8,12})/i);\n} else {\n  amountM = text.match(/Amount\\s*[:\\-]?\\s*Tk\\.?\\s*([\\d,]+(?:\\.\\d+)?)/i);\n  senderM = text.match(/Sender\\s*[:\\-]?\\s*(?:\\+?88)?(01\\d{9})/i);\n  trxM = text.match(/(?:TxnID|TrxID|Txn ID)\\s*[:\\-]?\\s*([A-Z0-9]{6,14})/i);\n}\nif (!amountM || !trxM) return blank({ reason: 'format_not_recognised', provider });\n\nreturn [{ json: {\n  parsed: true, provider,\n  amount: num(amountM[1]),\n  senderNumber: senderM ? senderM[1] : '',\n  trxId: trxM[1].toUpperCase(),\n  receivedAt: new Date().toISOString(),\n} }];"
      },
